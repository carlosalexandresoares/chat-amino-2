generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomRole {
  OWNER
  CO_ADMIN
  MEMBER
}

enum LiveStatus {
  ACTIVE
  ENDED
}

enum MessageType {
  TEXT
  AUDIO
  STICKER
}

enum ChatAssetKind {
  AUDIO
  STICKER
  WALLPAPER
}

enum PlaylistItemStatus {
  WAITING
  PLAYING
  PLAYED
  REMOVED
}

model User {
  id       String @id @default(cuid())
  username String @unique
  email    String @unique
  password String
  isSiteAdmin Boolean @default(false)

  avatar String?
  banner String?
  bio    String?

  xp    Int @default(0)
  level Int @default(1)
  @@index([xp, id])

  lastDailyXpAt DateTime?

  createdAt DateTime @default(now())

  messages        Message[]
  roomMemberships RoomMember[]
  ownedRooms      Room[]         @relation("RoomOwner")
  startedLives    LiveSession[]  @relation("LiveHost")
  playlistItems   PlaylistItem[] @relation("PlaylistAddedBy")
  followers       Follow[] @relation("FollowedUser")
  following       Follow[] @relation("FollowingUser")
  posts           Post[]
  xpEvents        XpEvent[]
  checkins        Checkin[]
  activity        UserActivity?
  postLikes       PostLike[]
  images          UserImage[]
  projectionDays  ProjectionDay[]
  projectionParticipants ProjectionParticipant[]
  projectionVisits ProjectionVisit[]
  projectionEngagement ProjectionEngagement?
  chatAssets ChatAsset[]
  stickers Sticker[]
  stickerPacks StickerPack[]
  stickerFavorites StickerFavorite[]
  chatAppearance ChatAppearance?
  reactions MessageReaction[]
}

model UserImage {
  userId String
  kind String
  data Bytes
  mimeType String
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
}

model Follow {
  followerId String
  followedId String
  createdAt DateTime @default(now())

  follower User @relation("FollowingUser", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("FollowedUser", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId])
}

model Post {
  id String @id @default(cuid())
  content String
  createdAt DateTime @default(now())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes PostLike[]
  featuredAt DateTime?
  featuredById String?

  @@index([userId, createdAt])
}

model PostLike {
  postId String
  userId String
  createdAt DateTime @default(now())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([postId, userId])
  @@index([userId])
}

model XpEvent {
  id String @id @default(cuid())
  userId String
  amount Int
  reason String
  sourceKey String @unique
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([reason, createdAt])
  @@index([createdAt, userId])
}

model Checkin {
  id String @id @default(cuid())
  userId String
  day DateTime @db.Date
  streak Int
  reward Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, day])
  @@index([userId, day])
}

model UserActivity {
  userId String @id
  activeSince DateTime?
  lastRealAt DateTime?
  lastPresenceXpAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Room {
  id String @id @default(cuid())

  name        String
  slug        String? @unique
  description String?
  category    String?
  avatar      String?
  banner      String?

  ownerId String?

  owner User? @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  messages Message[]
  members  RoomMember[]
  lives    LiveSession[]

  @@index([ownerId])
  @@index([category])
  @@index([createdAt])
}

model RoomMember {
  id String @id @default(cuid())

  role RoomRole @default(MEMBER)

  userId String
  roomId String

  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([roomId, role])
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  clientKey String? @unique
  content   String @default("")
  type MessageType @default(TEXT)
  mediaId String?
  replyToId String?
  deletedAt DateTime?
  createdAt DateTime @default(now())

  userId String
  roomId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  media ChatAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  replyTo Message? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies Message[] @relation("MessageReplies")
  reactions MessageReaction[]

  @@index([roomId, createdAt])
  @@index([userId])
  @@index([roomId, id])
  @@index([replyToId])
}

model MessageReaction {
  messageId String
  userId String
  emoji String
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([messageId, userId])
}

model ChatAsset {
  id String @id @default(cuid())
  key String @unique
  kind ChatAssetKind
  mimeType String
  size Int
  duration Float?
  ownerId String
  roomId String?
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages Message[]
  sticker Sticker?
  appearances ChatAppearance[]
  @@index([ownerId, createdAt])
}

model StickerPack {
  id String @id @default(cuid())
  name String
  ownerId String
  createdAt DateTime @default(now())
  stickers Sticker[]
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId])
}

model Sticker {
  id String @id @default(cuid())
  name String
  ownerId String
  assetId String @unique
  packId String?
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  asset ChatAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  pack StickerPack? @relation(fields: [packId], references: [id], onDelete: SetNull)
  favorites StickerFavorite[]
  @@index([ownerId, createdAt])
}

model StickerFavorite {
  userId String
  stickerId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sticker Sticker @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  @@id([userId, stickerId])
}

model ChatAppearance {
  userId String @id
  mode String @default("DEFAULT")
  color String?
  preset String?
  assetId String?
  positionX Int @default(50)
  positionY Int @default(50)
  darkness Int @default(0)
  overlay Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset ChatAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
}

model LiveSession {
  id String @id @default(cuid())

  status LiveStatus @default(ACTIVE)

  currentVideoId String?
  currentTime    Float   @default(0)
  isPlaying      Boolean @default(false)

  roomId String
  hostId String

  startedAt DateTime  @default(now())
  endedAt   DateTime?
  roomName String?
  repTickAt DateTime?
  hostRepSeconds Int @default(0)
  hostRepAccrued Int @default(0)
  hostRepCollected Int @default(0)
  participantRepGranted Int @default(0)
  uniqueVisitors Int @default(0)
  peakParticipants Int @default(0)
  messageCount Int @default(0)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  host User @relation("LiveHost", fields: [hostId], references: [id], onDelete: Cascade)

  playlist PlaylistItem[]
  participants ProjectionParticipant[]
  visits ProjectionVisit[]

  @@index([roomId, status])
  @@index([hostId])
}

model ProjectionDay {
  userId String
  day DateTime @db.Date
  hostAccrued Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, day])
}

model ProjectionParticipant {
  liveId String
  userId String
  joinedAt DateTime @default(now())
  lastLeftAt DateTime?
  confirmedAt DateTime?
  activeSeconds Int @default(0)
  repGranted Int @default(0)
  live LiveSession @relation(fields: [liveId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([liveId, userId])
  @@index([userId])
}

model ProjectionVisit {
  id String @id @default(cuid())
  liveId String
  userId String
  enteredAt DateTime @default(now())
  leftAt DateTime?
  live LiveSession @relation(fields: [liveId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([liveId, userId, leftAt])
}

model ProjectionEngagement {
  userId String @id
  liveId String
  confirmedAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlaylistItem {
  id String @id @default(cuid())

  videoId String
  title   String?

  position Int

  status PlaylistItemStatus @default(WAITING)

  liveId    String
  addedById String

  createdAt DateTime @default(now())

  live    LiveSession @relation(fields: [liveId], references: [id], onDelete: Cascade)
  addedBy User        @relation("PlaylistAddedBy", fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([liveId, position])
  @@index([liveId, status, position])
}
