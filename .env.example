DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000

# Bucket privado S3 compatível: AWS S3, Cloudflare R2 ou outro provedor.
# Para AWS S3, deixe CHAT_S3_ENDPOINT vazio e informe a região real.
CHAT_S3_BUCKET=
CHAT_S3_REGION=auto
CHAT_S3_ENDPOINT=
CHAT_S3_ACCESS_KEY_ID=
CHAT_S3_SECRET_ACCESS_KEY=
CHAT_AUDIO_MAX_SECONDS=120

# Cloudinary (preferido para deploy). Use credenciais da página API Keys.
# Todos os três campos são necessários. Mantenha-os somente no .env local e
# nas variáveis de ambiente do serviço de hospedagem.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Somente para desenvolvimento local. Em produção, configure Cloudinary ou S3/R2.
# Os arquivos ficam neste diretório e persistem entre reinícios do servidor local.
CHAT_STORAGE_DIR=.chat-uploads

# Web Push: gere um par VAPID uma vez e mantenha a chave privada somente no servidor.
# WEB_PUSH_SUBJECT deve ser um contato mailto: ou URL https: válido da aplicação.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Push nativo: configure somente no servidor. FCM recebe o JSON da conta de serviço.
FIREBASE_SERVICE_ACCOUNT_JSON=
# APNs usa uma chave .p8; use \n para as quebras de linha em ambientes com variável única.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.purp.app
APNS_ENV=sandbox

# ICE para WebRTC. JSON com servidores STUN/TURN.
# VOICE_ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"},{"urls":"turns:turn.example.com:5349","username":"usuario","credential":"senha"}]
# Sem configurar, usa STUN publico. TURN e recomendado em producao.
VOICE_ICE_SERVERS=

# Opcional: substitua os links da release pública por outras URLs HTTPS.
# Sem elas, o servidor local usa os builds presentes; o hospedado usa a release v0.1.0-beta.1.
PURP_ANDROID_DOWNLOAD_URL=
PURP_WINDOWS_DOWNLOAD_URL=
